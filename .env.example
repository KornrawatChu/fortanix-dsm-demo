# Copy to .env and fill in. NEVER commit .env.

# rest | sdk | mock   (can also be switched live in the UI sidebar)
DSM_BACKEND=rest

# Your DSM SaaS region endpoint, e.g. https://amer.smartkey.io, https://eu.smartkey.io,
# https://uk.smartkey.io, https://apac.smartkey.io, https://au.smartkey.io
DSM_ENDPOINT=https://apac.smartkey.io

# DSM UI -> Apps -> <your app> -> "View API key details" -> copy the API key (base64 string)
DSM_API_KEY=

# Optional: group the demo keys are created in (only needed if the app belongs to several groups)
DSM_GROUP_ID=

DSM_VERIFY_TLS=true

# PostgreSQL in Docker (docker compose up -d). Pick any local password.
# Leave DATABASE_URL empty to fall back to a local SQLite file (data\bank.db).
PG_PASSWORD=
DATABASE_URL=postgresql://bank_app:<PG_PASSWORD>@127.0.0.1:5432/horizon_bank
